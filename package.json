{
  "name": "@freddricklogan/devkit",
  "version": "1.0.0",
  "description": "One command-line tool for five development chores: HTTP request testing with assertions, a static dev server with SPA fallback, git branch and commit-message checks, project scaffolding from templates, and a file organiser with dry-run and duplicate detection.",
  "type": "module",
  "license": "MIT",
  "author": "Freddrick Logan",
  "repository": { "type": "git", "url": "git+https://github.com/Freddricklogan/cli-development-tools.git" },
  "bin": { "devkit": "./dist/cli.js" },
  "files": ["dist", "templates", "README.md", "LICENSE"],
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && chmod +x dist/cli.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "sbom": "cyclonedx-npm --output-format JSON --output-file sbom.cdx.json --omit dev",
    "check": "npm run lint && npm run typecheck && npm test -- --run && npm run build"
  },
  "dependencies": {
    "commander": "^13.1.0"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "^2.0.0",
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
